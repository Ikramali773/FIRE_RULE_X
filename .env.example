# Environment Variables for FireRuleX
# Copy this file to .env.local and fill in your API keys

# OpenAI (GPT-4o for floor plan analysis)
OPENAI_API_KEY=your_openai_api_key_here

# GroupDocs Cloud (DWG/PDF to PNG conversion)
GROUPDOCS_CLIENT_ID=your_groupdocs_client_id
GROUPDOCS_CLIENT_SECRET=your_groupdocs_client_secret
