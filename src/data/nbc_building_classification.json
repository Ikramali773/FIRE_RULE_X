    },
    "occupancyGroups": {
        "A": {
            "label": "Residential",
            "description": "Buildings where sleeping accommodation is provided for normal residential purposes.",
            "subdivisions": {
                "A-1": {
                    "label": "Lodging or Rooming Houses",
                    "description": "Separate sleeping for not more than 40 persons.",
                    "examples": [
                        "inns",
                        "clubs",
                        "motels",
                        "guest houses"
                    ],
                    "maxOccupants": 40
                },
                "A-2": {
                    "label": "One or Two-Family Private Dwellings",
                    "description": "Private homes with sleeping for not more than 20 persons.",
                    "examples": [
                        "private homes"
                    ],
                    "maxOccupants": 20
                },
                "A-3": {
                    "label": "Dormitories",
                    "description": "Group sleeping for non-family members under joint occupancy.",
                    "examples": [
                        "school hostels",
                        "college hostels",
                        "military barracks"
                    ]
                },
                "A-4": {
                    "label": "Apartment Houses (Flats)",
                    "description": "Living quarters for 3 or more families living independently.",
                    "examples": [
                        "residential apartments"
                    ],
                    "minFamilies": 3
                },
                "A-5": {
                    "label": "Hotels",
                    "description": "Single management, sleeping for more than 40 persons.",
                    "examples": [
                        "hotels",
                        "motels"
                    ],
                    "minOccupants": 41
                },
                "A-6": {
                    "label": "Hotels (Starred)",
                    "description": "Five-star and above hotels.",
                    "examples": [
                        "luxury hotels",
                        "five-star hotels"
                    ]
                }
            }
        },
        "B": {
            "label": "Educational",
            "description": "Used for schools, colleges, or training institutions.",
            "subdivisions": {
                "B-1": {
                    "label": "Schools up to Senior Secondary Level",
                    "description": "Buildings with not less than 20 students.",
                    "examples": [
                        "primary schools",
                        "secondary schools",
                        "senior secondary schools"
                    ],
                    "minStudents": 20
                },
                "B-2": {
                    "label": "All Others / Training Institutions",
                    "description": "Higher education or training with not less than 100 students.",
                    "examples": [
                        "colleges",
                        "universities",
                        "training centres"
                    ],
                    "minStudents": 100
                }
            }
        },
        "C": {
            "label": "Institutional",
            "description": "Used for medical treatment, care of the aged/infirm, or penal/correctional detention.",
            "subdivisions": {
                "C-1": {
                    "label": "Hospitals and Sanatoria",
                    "description": "Housing persons with physical limitations.",
                    "examples": [
                        "hospitals",
                        "nursing homes",
                        "sanatoria"
                    ]
                },
                "C-2": {
                    "label": "Custodial Institutions",
                    "description": "Care of children, convalescents, or the aged.",
                    "examples": [
                        "orphanages",
                        "old age homes",
                        "convalescent homes"
                    ]
                },
                "C-3": {
                    "label": "Penal and Mental Institutions",
                    "description": "Housing persons under restraint.",
                    "examples": [
                        "jails",
                        "prisons",
                        "mental hospitals",
                        "reformatories"
                    ]
                }
            }
        },
        "D": {
            "label": "Assembly",
            "description": "Where 50 or more persons gather for amusement, recreation, or similar purposes.",
            "minOccupantsForClassification": 50,
            "subdivisions": {
                "D-1": {
                    "label": "Large Theatres",
                    "description": "Theatres or stage buildings with fixed seats for over 1000 persons.",
                    "examples": [
                        "large theatres",
                        "opera houses"
                    ],
                    "minFixedSeats": 1001
                },
                "D-2": {
                    "label": "Small Theatres",
                    "description": "Similar to D-1, but with fixed seats up to 1000 persons.",
                    "examples": [
                        "small theatres",
                        "auditoriums"
                    ],
                    "maxFixedSeats": 1000
                },
                "D-3": {
                    "label": "Assembly Halls (Large)",
                    "description": "No permanent stage, accommodation for 300 or more persons.",
                    "examples": [
                        "conference halls",
                        "banquet halls"
                    ],
                    "minCapacity": 300
                },
                "D-4": {
                    "label": "Assembly Halls (Small)",
                    "description": "No permanent stage, accommodation for less than 300 persons.",
                    "examples": [
                        "meeting rooms",
                        "community halls"
                    ],
                    "maxCapacity": 299
                },
                "D-5": {
                    "label": "Outdoor Assembly",
                    "description": "All other outdoor assembly structures.",
                    "examples": [
                        "grandstands",
                        "stadia",
                        "circus tents",
                        "amusement parks"
                    ]
                },
                "D-6": {
                    "label": "Mixed-Use Assembly",
                    "description": "Mixed-use assembly buildings combining entertainment with commercial.",
                    "examples": [
                        "multiplexes with shopping",
                        "entertainment complexes with restaurants"
                    ]
                },
                "D-7": {
                    "label": "Other Assembly",
                    "description": "Any other assembly structure not covered above.",
                    "examples": [
                        "religious buildings",
                        "exhibition halls"
                    ]
                }
            }
        },
        "E": {
            "label": "Business",
            "description": "Used for transaction of business, record-keeping, or professional services.",
            "subdivisions": {
                "E-1": {
                    "label": "Offices and Banks",
                    "description": "Offices, banks, professional establishments.",
                    "examples": [
                        "offices",
                        "banks",
                        "professional establishments",
                        "police stations"
                    ]
                },
                "E-2": {
                    "label": "Laboratories and Libraries",
                    "description": "Laboratories, research establishments, libraries.",
                    "examples": [
                        "laboratories",
                        "research establishments",
                        "libraries"
                    ]
                },
                "E-3": {
                    "label": "Computer Installations",
                    "description": "Computer centres and data centres.",
                    "examples": [
                        "data centres",
                        "computer installations"
                    ]
                },
                "E-4": {
                    "label": "Telephone Exchanges",
                    "description": "Telephone exchanges and communication facilities.",
                    "examples": [
                        "telephone exchanges"
                    ]
                },
                "E-5": {
                    "label": "Broadcasting Stations",
                    "description": "Broadcasting and TV stations.",
                    "examples": [
                        "broadcasting stations",
                        "TV stations",
                        "radio stations"
                    ]
                }
            }
        },
        "F": {
            "label": "Mercantile",
            "description": "Used as shops, stores, or markets for display and sale of merchandise.",
            "subdivisions": {
                "F-1": {
                    "label": "Small Shops",
                    "description": "Retail area up to 500 m².",
                    "examples": [
                        "small shops",
                        "boutiques"
                    ],
                    "maxAreaM2": 500
                },
                "F-2": {
                    "label": "Large Shops / Malls",
                    "description": "Retail area more than 500 m².",
                    "examples": [
                        "department stores",
                        "shopping malls",
                        "supermarkets"
                    ],
                    "minAreaM2": 501
                },
                "F-3": {
                    "label": "Underground Shopping",
                    "description": "Underground shopping centres.",
                    "examples": [
                        "underground malls",
                        "subway shopping"
                    ]
                }
            }
        },
        "G": {
            "label": "Industrial",
            "description": "Where products or materials are fabricated, assembled, or processed.",
            "subdivisions": {
                "G-1": {
                    "label": "Low Hazard Industrial",
                    "description": "Contents of low combustibility; no self-propagating fire possible.",
                    "hazardLevel": "low",
                    "examples": [
                        "power plants",
                        "steel mills",
                        "ice plants"
                    ]
                },
                "G-2": {
                    "label": "Moderate Hazard Industrial",
                    "description": "Burn with moderate rapidity; may give off considerable smoke but no toxic fumes/explosions.",
                    "hazardLevel": "moderate",
                    "examples": [
                        "automobile assembly",
                        "dry cleaning",
                        "printing",
                        "electronics manufacturing"
                    ]
                },
                "G-3": {
                    "label": "High Hazard Industrial",
                    "description": "Burn with extreme rapidity; liable to give off toxic fumes or explosions.",
                    "hazardLevel": "high",
                    "examples": [
                        "chemical plants",
                        "paint manufacturing",
                        "explosives",
                        "fireworks"
                    ]
                }
            }
        },
        "H": {
            "label": "Storage",
            "description": "Primarily for storage or sheltering of goods, merchandise, vehicles, or animals.",
            "subdivisions": {
                "H": {
                    "label": "Storage",
                    "description": "Warehouses, cold storage, hangars, grain elevators, freight depots.",
                    "examples": [
                        "warehouses",
                        "cold storage",
                        "hangars",
                        "grain elevators",
                        "freight depots",
                        "truck terminals"
                    ]
                }
            }
        },
        "J": {
            "label": "Hazardous",
            "description": "Storage or handling of highly combustible, explosive, or toxic materials.",
            "subdivisions": {
                "J": {
                    "label": "Hazardous",
                    "description": "Highly combustible, explosive, or toxic material storage/handling. Includes base kitchens over 100 m².",
                    "examples": [
                        "LPG storage",
                        "rocket propellants",
                        "ammunition factories",
                        "fireworks storage",
                        "base kitchens over 100 m²"
                    ]
                }
            }
        }
    },
    "occupantLoadFactors": {
        "_clause": "Table 3 — Occupant Load",
        "_description": "Floor area per person (m²/person) for calculating maximum occupant load. Occupant Load = Total Floor Area / Occupant Load Factor.",
        "_notes": [
            "Indoor patient area includes rooms and nurseries but excludes nurse stations and corridors.",
            "For fixed seating, the occupant load is the actual number of fixed seats.",
            "Storage load factor applies to warehouses where occupant numbers are very limited."
        ],
        "factors": {
            "A": {
                "default": 12.50,
                "unit": "m2_per_person"
            },
            "B": {
                "default": 4.00,
                "unit": "m2_per_person"
            },
            "C": {
                "indoor_patients": 15.00,
                "outdoor_patients": 10.00,
                "unit": "m2_per_person"
            },
            "D": {
                "concentrated_no_fixed_seats": 0.65,
                "less_concentrated_no_fixed_seats": 1.40,
                "fixed_seating": "ACTUAL_SEAT_COUNT",
                "dining_restaurants": 1.80,
                "unit": "m2_per_person"
            },
            "E": {
                "default": 10.00,
                "unit": "m2_per_person"
            },
            "F": {
                "street_floor_sales_basement": 3.00,
                "upper_sales_floors": 6.00,
                "storage_warehouse": 20.00,
                "unit": "m2_per_person"
            },
            "G": {
                "default": 10.00,
                "unit": "m2_per_person"
            },
            "H": {
                "default": 30.00,
                "unit": "m2_per_person"
            },
            "J": {
                "default": 10.00,
                "unit": "m2_per_person"
            }
        }
    },
