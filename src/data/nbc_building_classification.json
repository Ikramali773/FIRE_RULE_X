    "_metadata": {
        "standard": "NBC 2016 Part IV — Fire and Life Safety",
        "title": "National Building Code of India 2016 — Part IV Fire and Life Safety",
        "version": "2016",
        "created": "2026-03-05",
        "sections": {
            "buildingClassification": "Section 3.1 — Classification of Buildings Based on Occupancy",
            "occupantLoad": "Table 3 — Occupant Load",
            "capacityFactors": "Table 4 — Capacity Factors",
            "travelDistance": "Table 5 — Travel Distance to Exits"
